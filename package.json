{
  "name": "aoh-solution-explorer",
  "displayName": "AOH - Solution Explorer",
  "description": "A Rider-inspired .NET solution explorer for VS Code.",
  "version": "1.11.7",
  "publisher": "Abyzz",
  "icon": "media/aoh-logo-icon.png",
  "license": "WTFPL",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aoh-solution-explorer",
          "title": "AOH - Solution Explorer",
          "icon": "media/explorer.svg"
        }
      ]
    },
    "views": {
      "aoh-solution-explorer": [
        {
          "id": "aoh.solutionExplorer.view",
          "name": "Solution"
        }
      ]
    },
    "commands": [
      {
        "command": "aoh.solutionExplorer.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "aoh.solutionExplorer.createSolution",
        "title": "Create New Solution...",
        "icon": "$(new-file)"
      },
      {
        "command": "aoh.solutionExplorer.selectCurrentFile",
        "title": "Select Current File",
        "icon": {
          "light": "media/select-current-file.svg",
          "dark": "media/select-current-file.svg"
        }
      },
      {
        "command": "aoh.solutionExplorer.enableFollowEditor",
        "title": "Follow Editor File",
        "icon": {
          "light": "media/follow-active-file-disabled.svg",
          "dark": "media/follow-active-file-disabled.svg"
        }
      },
      {
        "command": "aoh.solutionExplorer.disableFollowEditor",
        "title": "Stop Following Editor File",
        "icon": {
          "light": "media/follow-active-file.svg",
          "dark": "media/follow-active-file.svg"
        }
      },
      {
        "command": "aoh.solutionExplorer.newProject",
        "title": "New Project...",
        "icon": "$(project)"
      },
      {
        "command": "aoh.solutionExplorer.newSolutionFolder",
        "title": "New Solution Folder",
        "icon": "$(new-folder)"
      },
      {
        "command": "aoh.solutionExplorer.addExistingProject",
        "title": "Existing Project...",
        "icon": "$(project)"
      },
      {
        "command": "aoh.solutionExplorer.addExistingItem",
        "title": "Existing Item...",
        "icon": "$(file-add)"
      },
      {
        "command": "aoh.solutionExplorer.newFile",
        "title": "New File...",
        "icon": "$(new-file)"
      },
      {
        "command": "aoh.solutionExplorer.newFolder",
        "title": "New Folder",
        "icon": "$(new-folder)"
      },
      {
        "command": "aoh.solutionExplorer.newDotNetFile",
        "title": "New .NET File...",
        "icon": "$(new-file)"
      },
      {
        "command": "aoh.solutionExplorer.addProjectReference",
        "title": "Project Reference...",
        "icon": "$(references)"
      },
      {
        "command": "aoh.solutionExplorer.gitStage",
        "title": "Stage",
        "icon": "$(check)"
      },
      {
        "command": "aoh.solutionExplorer.gitUnstage",
        "title": "Git: Unstage",
        "icon": "$(remove)"
      },
      {
        "command": "aoh.solutionExplorer.gitRollback",
        "title": "Rollback",
        "icon": "$(discard)"
      },
      {
        "command": "aoh.solutionExplorer.buildSolution",
        "title": "Build Solution"
      },
      {
        "command": "aoh.solutionExplorer.rebuildSolution",
        "title": "Rebuild Solution"
      },
      {
        "command": "aoh.solutionExplorer.cleanSolution",
        "title": "Clean Solution"
      },
      {
        "command": "aoh.solutionExplorer.buildProject",
        "title": "Build Project"
      },
      {
        "command": "aoh.solutionExplorer.rebuildProject",
        "title": "Rebuild Project"
      },
      {
        "command": "aoh.solutionExplorer.cleanProject",
        "title": "Clean Project"
      },
      {
        "command": "aoh.solutionExplorer.packProject",
        "title": "Pack Project"
      },
      {
        "command": "aoh.solutionExplorer.publishProject",
        "title": "Publish Project..."
      },
      {
        "command": "aoh.solutionExplorer.open",
        "title": "Open"
      },
      {
        "command": "aoh.solutionExplorer.openToSide",
        "title": "Open to the Side"
      },
      {
        "command": "aoh.solutionExplorer.rename",
        "title": "Rename...",
        "icon": "$(edit)"
      },
      {
        "command": "aoh.solutionExplorer.delete",
        "title": "Delete",
        "icon": "$(trash)"
      },
      {
        "command": "aoh.solutionExplorer.copyPath",
        "title": "Copy Path"
      },
      {
        "command": "aoh.solutionExplorer.copyRelativePath",
        "title": "Copy Relative Path"
      },
      {
        "command": "aoh.solutionExplorer.openTerminal",
        "title": "Integrated Terminal",
        "icon": "$(terminal)"
      },
      {
        "command": "aoh.solutionExplorer.reveal",
        "title": "Containing Folder",
        "icon": "$(folder-opened)"
      },
      {
        "command": "aoh.solutionExplorer.findInFiles",
        "title": "Find in Files..."
      },
      {
        "command": "aoh.solutionExplorer.replaceInFiles",
        "title": "Replace in Files..."
      },
      {
        "command": "aoh.solutionExplorer.newClass",
        "title": "Class",
        "icon": "$(symbol-class)"
      },
      {
        "command": "aoh.solutionExplorer.newInterface",
        "title": "Interface",
        "icon": "$(symbol-interface)"
      },
      {
        "command": "aoh.solutionExplorer.newEnum",
        "title": "Enum",
        "icon": "$(symbol-enum)"
      },
      {
        "command": "aoh.solutionExplorer.newStruct",
        "title": "Struct",
        "icon": "$(symbol-struct)"
      },
      {
        "command": "aoh.solutionExplorer.newRecord",
        "title": "Record",
        "icon": "$(symbol-class)"
      },
      {
        "command": "aoh.solutionExplorer.copy",
        "title": "Copy",
        "icon": "$(copy)"
      },
      {
        "command": "aoh.solutionExplorer.cut",
        "title": "Cut",
        "icon": "$(clippy)"
      },
      {
        "command": "aoh.solutionExplorer.paste",
        "title": "Paste",
        "icon": "$(files)"
      },
      {
        "command": "aoh.solutionExplorer.copyPathSolution",
        "title": "Relative to Solution",
        "icon": "$(file-symlink-file)"
      },
      {
        "command": "aoh.solutionExplorer.copyPathWorkspace",
        "title": "Relative to Workspace",
        "icon": "$(file-symlink-file)"
      },
      {
        "command": "aoh.solutionExplorer.copyPathFull",
        "title": "Full",
        "icon": "$(copy)"
      },
      {
        "command": "aoh.solutionExplorer.gitTrack",
        "title": "Track",
        "icon": "$(add)"
      },
      {
        "command": "aoh.solutionExplorer.gitUntrack",
        "title": "Untrack",
        "icon": "$(remove)"
      },
      {
        "command": "aoh.solutionExplorer.showExcludedFiles",
        "title": "Show Excluded Files",
        "icon": {
          "light": "media/show_files.svg",
          "dark": "media/show_files.svg"
        }
      },
      {
        "command": "aoh.solutionExplorer.hideExcludedFiles",
        "title": "Hide Excluded Files",
        "icon": {
          "light": "media/hide_files.svg",
          "dark": "media/hide_files.svg"
        }
      },
      {
        "command": "aoh.solutionExplorer.showOutput",
        "title": "Show AOH Solution Explorer Output",
        "icon": "$(output)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "aoh.solutionExplorer.selectCurrentFile",
          "when": "view == aoh.solutionExplorer.view",
          "group": "navigation@1"
        },
        {
          "command": "aoh.solutionExplorer.enableFollowEditor",
          "when": "view == aoh.solutionExplorer.view && !aoh.solutionExplorer.followEditor",
          "group": "navigation@2"
        },
        {
          "command": "aoh.solutionExplorer.disableFollowEditor",
          "when": "view == aoh.solutionExplorer.view && aoh.solutionExplorer.followEditor",
          "group": "navigation@2"
        },
        {
          "command": "aoh.solutionExplorer.showExcludedFiles",
          "when": "view == aoh.solutionExplorer.view && !aoh.solutionExplorer.showExcludedFiles",
          "group": "navigation@3"
        },
        {
          "command": "aoh.solutionExplorer.hideExcludedFiles",
          "when": "view == aoh.solutionExplorer.view && aoh.solutionExplorer.showExcludedFiles",
          "group": "navigation@3"
        },
        {
          "command": "aoh.solutionExplorer.refresh",
          "when": "view == aoh.solutionExplorer.view",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "submenu": "aoh.solutionExplorer.add",
          "when": "view == aoh.solutionExplorer.view && (viewItem =~ /aoh\\.(solution|solutionFolder|project|folder|file)/ || viewItem == aoh.dependencies)",
          "group": "1_add"
        },
        {
          "submenu": "aoh.solutionExplorer.build",
          "when": "view == aoh.solutionExplorer.view && viewItem =~ /aoh\\.(solution|project)/",
          "group": "2_build"
        },
        {
          "submenu": "aoh.solutionExplorer.edit",
          "when": "view == aoh.solutionExplorer.view && viewItem =~ /aoh\\.(solution|solutionFolder|project|folder|file)/",
          "group": "3_edit"
        },
        {
          "submenu": "aoh.solutionExplorer.copyPath",
          "when": "view == aoh.solutionExplorer.view && viewItem =~ /aoh\\.(solution|project|folder|file)/",
          "group": "4_path"
        },
        {
          "submenu": "aoh.solutionExplorer.git",
          "when": "view == aoh.solutionExplorer.view && viewItem =~ /aoh\\.(solution|solutionFolder|project|folder|file)/",
          "group": "5_git"
        },
        {
          "submenu": "aoh.solutionExplorer.openIn",
          "when": "view == aoh.solutionExplorer.view && viewItem =~ /aoh\\.(solution|project|folder|file)/",
          "group": "6_open"
        }
      ],
      "aoh.solutionExplorer.add": [
        {
          "command": "aoh.solutionExplorer.newProject",
          "when": "viewItem == aoh.solution",
          "group": "1_solution@1"
        },
        {
          "command": "aoh.solutionExplorer.addExistingProject",
          "when": "viewItem == aoh.solution",
          "group": "1_solution@2"
        },
        {
          "command": "aoh.solutionExplorer.newSolutionFolder",
          "when": "viewItem == aoh.solution",
          "group": "2_solution@1"
        },
        {
          "command": "aoh.solutionExplorer.newProject",
          "when": "viewItem == aoh.solutionFolder",
          "group": "1_solutionFolder@1"
        },
        {
          "command": "aoh.solutionExplorer.addExistingProject",
          "when": "viewItem == aoh.solutionFolder",
          "group": "1_solutionFolder@2"
        },
        {
          "command": "aoh.solutionExplorer.newSolutionFolder",
          "when": "viewItem == aoh.solutionFolder",
          "group": "2_solutionFolder@1"
        },
        {
          "command": "aoh.solutionExplorer.addExistingItem",
          "when": "viewItem == aoh.solutionFolder",
          "group": "3_solutionFolder@1"
        },
        {
          "command": "aoh.solutionExplorer.newDotNetFile",
          "when": "viewItem =~ /aoh\\.(project|folder|file)/",
          "group": "1_files@1"
        },
        {
          "command": "aoh.solutionExplorer.newFile",
          "when": "viewItem =~ /aoh\\.(project|folder|file)/",
          "group": "1_files@2"
        },
        {
          "command": "aoh.solutionExplorer.newFolder",
          "when": "viewItem =~ /aoh\\.(project|folder|file)/",
          "group": "1_files@3"
        },
        {
          "command": "aoh.solutionExplorer.newClass",
          "when": "viewItem =~ /aoh\\.(project|folder|file)/",
          "group": "2_types@1"
        },
        {
          "command": "aoh.solutionExplorer.newInterface",
          "when": "viewItem =~ /aoh\\.(project|folder|file)/",
          "group": "2_types@2"
        },
        {
          "command": "aoh.solutionExplorer.newEnum",
          "when": "viewItem =~ /aoh\\.(project|folder|file)/",
          "group": "2_types@3"
        },
        {
          "command": "aoh.solutionExplorer.newStruct",
          "when": "viewItem =~ /aoh\\.(project|folder|file)/",
          "group": "2_types@4"
        },
        {
          "command": "aoh.solutionExplorer.newRecord",
          "when": "viewItem =~ /aoh\\.(project|folder|file)/",
          "group": "2_types@5"
        },
        {
          "command": "aoh.solutionExplorer.addExistingItem",
          "when": "viewItem =~ /aoh\\.(project|folder)/",
          "group": "3_existing@1"
        },
        {
          "command": "aoh.solutionExplorer.addProjectReference",
          "when": "viewItem == aoh.dependencies",
          "group": "1_reference@1"
        }
      ],
      "aoh.solutionExplorer.edit": [
        {
          "command": "aoh.solutionExplorer.copy",
          "group": "1_clipboard@1"
        },
        {
          "command": "aoh.solutionExplorer.cut",
          "group": "1_clipboard@2"
        },
        {
          "command": "aoh.solutionExplorer.paste",
          "group": "1_clipboard@3"
        },
        {
          "command": "aoh.solutionExplorer.rename",
          "group": "2_modify@1"
        },
        {
          "command": "aoh.solutionExplorer.delete",
          "group": "2_modify@2"
        }
      ],
      "aoh.solutionExplorer.openIn": [
        {
          "command": "aoh.solutionExplorer.reveal",
          "group": "1_open@1"
        },
        {
          "command": "aoh.solutionExplorer.openTerminal",
          "group": "1_open@2"
        }
      ],
      "commandPalette": [
        {
          "command": "aoh.solutionExplorer.newProject",
          "when": "false"
        },
        {
          "command": "aoh.solutionExplorer.newSolutionFolder",
          "when": "false"
        },
        {
          "command": "aoh.solutionExplorer.addExistingProject",
          "when": "false"
        },
        {
          "command": "aoh.solutionExplorer.addExistingItem",
          "when": "false"
        },
        {
          "command": "aoh.solutionExplorer.newFile",
          "when": "false"
        },
        {
          "command": "aoh.solutionExplorer.newFolder",
          "when": "false"
        },
        {
          "command": "aoh.solutionExplorer.newDotNetFile",
          "when": "false"
        },
        {
          "command": "aoh.solutionExplorer.addProjectReference",
          "when": "false"
        },
        {
          "command": "aoh.solutionExplorer.gitStage",
          "when": "false"
        },
        {
          "command": "aoh.solutionExplorer.gitUnstage",
          "when": "false"
        },
        {
          "command": "aoh.solutionExplorer.gitRollback",
          "when": "false"
        },
        {
          "command": "aoh.solutionExplorer.buildSolution",
          "when": "false"
        },
        {
          "command": "aoh.solutionExplorer.rebuildSolution",
          "when": "false"
        },
        {
          "command": "aoh.solutionExplorer.cleanSolution",
          "when": "false"
        },
        {
          "command": "aoh.solutionExplorer.buildProject",
          "when": "false"
        },
        {
          "command": "aoh.solutionExplorer.rebuildProject",
          "when": "false"
        },
        {
          "command": "aoh.solutionExplorer.cleanProject",
          "when": "false"
        },
        {
          "command": "aoh.solutionExplorer.packProject",
          "when": "false"
        },
        {
          "command": "aoh.solutionExplorer.publishProject",
          "when": "false"
        },
        {
          "command": "aoh.solutionExplorer.open",
          "when": "false"
        },
        {
          "command": "aoh.solutionExplorer.openToSide",
          "when": "false"
        },
        {
          "command": "aoh.solutionExplorer.rename",
          "when": "false"
        },
        {
          "command": "aoh.solutionExplorer.delete",
          "when": "false"
        },
        {
          "command": "aoh.solutionExplorer.copyPath",
          "when": "false"
        },
        {
          "command": "aoh.solutionExplorer.copyRelativePath",
          "when": "false"
        },
        {
          "command": "aoh.solutionExplorer.openTerminal",
          "when": "false"
        },
        {
          "command": "aoh.solutionExplorer.reveal",
          "when": "false"
        },
        {
          "command": "aoh.solutionExplorer.findInFiles",
          "when": "false"
        },
        {
          "command": "aoh.solutionExplorer.replaceInFiles",
          "when": "false"
        },
        {
          "command": "aoh.solutionExplorer.newClass",
          "when": "false"
        },
        {
          "command": "aoh.solutionExplorer.newInterface",
          "when": "false"
        },
        {
          "command": "aoh.solutionExplorer.newEnum",
          "when": "false"
        },
        {
          "command": "aoh.solutionExplorer.newStruct",
          "when": "false"
        },
        {
          "command": "aoh.solutionExplorer.newRecord",
          "when": "false"
        },
        {
          "command": "aoh.solutionExplorer.copy",
          "when": "false"
        },
        {
          "command": "aoh.solutionExplorer.cut",
          "when": "false"
        },
        {
          "command": "aoh.solutionExplorer.paste",
          "when": "false"
        },
        {
          "command": "aoh.solutionExplorer.copyPathSolution",
          "when": "false"
        },
        {
          "command": "aoh.solutionExplorer.copyPathWorkspace",
          "when": "false"
        },
        {
          "command": "aoh.solutionExplorer.copyPathFull",
          "when": "false"
        },
        {
          "command": "aoh.solutionExplorer.gitTrack",
          "when": "false"
        },
        {
          "command": "aoh.solutionExplorer.gitUntrack",
          "when": "false"
        }
      ],
      "aoh.solutionExplorer.build": [
        {
          "command": "aoh.solutionExplorer.buildSolution",
          "when": "viewItem == aoh.solution",
          "group": "1_build@1"
        },
        {
          "command": "aoh.solutionExplorer.rebuildSolution",
          "when": "viewItem == aoh.solution",
          "group": "1_build@2"
        },
        {
          "command": "aoh.solutionExplorer.cleanSolution",
          "when": "viewItem == aoh.solution",
          "group": "2_clean@1"
        },
        {
          "command": "aoh.solutionExplorer.buildProject",
          "when": "viewItem == aoh.project",
          "group": "1_build@1"
        },
        {
          "command": "aoh.solutionExplorer.rebuildProject",
          "when": "viewItem == aoh.project",
          "group": "1_build@2"
        },
        {
          "command": "aoh.solutionExplorer.cleanProject",
          "when": "viewItem == aoh.project",
          "group": "2_clean@1"
        }
      ],
      "aoh.solutionExplorer.copyPath": [
        {
          "command": "aoh.solutionExplorer.copyPathSolution",
          "group": "1_relative@1"
        },
        {
          "command": "aoh.solutionExplorer.copyPathWorkspace",
          "group": "1_relative@2"
        },
        {
          "command": "aoh.solutionExplorer.copyPathFull",
          "group": "2_full@1"
        }
      ],
      "aoh.solutionExplorer.git": [
        {
          "command": "aoh.solutionExplorer.gitTrack",
          "group": "1_track@1"
        },
        {
          "command": "aoh.solutionExplorer.gitUntrack",
          "group": "1_track@2"
        },
        {
          "command": "aoh.solutionExplorer.gitStage",
          "group": "2_stage@1"
        },
        {
          "command": "aoh.solutionExplorer.gitRollback",
          "group": "3_rollback@1"
        }
      ]
    },
    "submenus": [
      {
        "id": "aoh.solutionExplorer.add",
        "label": "Add"
      },
      {
        "id": "aoh.solutionExplorer.edit",
        "label": "Edit"
      },
      {
        "id": "aoh.solutionExplorer.openIn",
        "label": "Open In"
      },
      {
        "id": "aoh.solutionExplorer.build",
        "label": "Build"
      },
      {
        "id": "aoh.solutionExplorer.copyPath",
        "label": "Copy File Path"
      },
      {
        "id": "aoh.solutionExplorer.git",
        "label": "Git"
      }
    ],
    "configuration": {
      "title": "AOH Solution Explorer",
      "properties": {
        "aoh.solutionExplorer.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "bin",
            "obj"
          ],
          "description": "Glob patterns for files and folders hidden in the AOH Solution Explorer. Use the toolbar toggle to temporarily show excluded items."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.6.0"
  },
  "activationEvents": [
    "onStartupFinished",
    "onView:aoh.solutionExplorer.view",
    "onCommand:aoh.solutionExplorer.refresh",
    "onCommand:aoh.solutionExplorer.createSolution",
    "onCommand:aoh.solutionExplorer.selectCurrentFile",
    "onCommand:aoh.solutionExplorer.enableFollowEditor",
    "onCommand:aoh.solutionExplorer.disableFollowEditor",
    "onCommand:aoh.solutionExplorer.newProject",
    "onCommand:aoh.solutionExplorer.newSolutionFolder",
    "onCommand:aoh.solutionExplorer.addExistingProject",
    "onCommand:aoh.solutionExplorer.addExistingItem",
    "onCommand:aoh.solutionExplorer.newFile",
    "onCommand:aoh.solutionExplorer.newFolder",
    "onCommand:aoh.solutionExplorer.newDotNetFile",
    "onCommand:aoh.solutionExplorer.addProjectReference",
    "onCommand:aoh.solutionExplorer.gitStage",
    "onCommand:aoh.solutionExplorer.gitUnstage",
    "onCommand:aoh.solutionExplorer.gitRollback",
    "onCommand:aoh.solutionExplorer.buildSolution",
    "onCommand:aoh.solutionExplorer.rebuildSolution",
    "onCommand:aoh.solutionExplorer.cleanSolution",
    "onCommand:aoh.solutionExplorer.buildProject",
    "onCommand:aoh.solutionExplorer.rebuildProject",
    "onCommand:aoh.solutionExplorer.cleanProject",
    "onCommand:aoh.solutionExplorer.packProject",
    "onCommand:aoh.solutionExplorer.publishProject",
    "onCommand:aoh.solutionExplorer.open",
    "onCommand:aoh.solutionExplorer.openToSide",
    "onCommand:aoh.solutionExplorer.rename",
    "onCommand:aoh.solutionExplorer.delete",
    "onCommand:aoh.solutionExplorer.copyPath",
    "onCommand:aoh.solutionExplorer.copyRelativePath",
    "onCommand:aoh.solutionExplorer.openTerminal",
    "onCommand:aoh.solutionExplorer.reveal",
    "onCommand:aoh.solutionExplorer.findInFiles",
    "onCommand:aoh.solutionExplorer.replaceInFiles",
    "onCommand:aoh.solutionExplorer.newClass",
    "onCommand:aoh.solutionExplorer.newInterface",
    "onCommand:aoh.solutionExplorer.newEnum",
    "onCommand:aoh.solutionExplorer.newStruct",
    "onCommand:aoh.solutionExplorer.newRecord",
    "onCommand:aoh.solutionExplorer.copy",
