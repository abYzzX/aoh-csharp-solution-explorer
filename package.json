    "configuration": {
      "title": "AOH Solution Explorer",
      "properties": {
        "aoh.solutionExplorer.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "bin",
            "obj"
          ],
          "description": "Glob patterns for files and folders hidden in the AOH Solution Explorer. Use the toolbar toggle to temporarily show excluded items."
        },
        "aoh.solutionExplorer.colorMode": {
          "type": "string",
          "enum": [
            "both",
            "git",
            "errors",
            "none"
          ],
          "enumItemLabels": [
            "Both",
            "Git Colors",
            "Error Colors",
            "None"
          ],
          "default": "both",
          "description": "Controls status coloring in the AOH Solution Explorer. In Both mode error colors take priority over Git colors. Deleted Git items are intentionally not colored."
        },
        "aoh.solutionExplorer.git.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Automatically refresh Git status colors when the Git repository state changes, for example after stage, commit, checkout or push operations."
        },
        "aoh.solutionExplorer.git.refreshDelay": {
          "type": "number",
          "default": 150,
          "minimum": 50,
          "maximum": 5000,
          "description": "Debounce delay in milliseconds before refreshing Git status colors after a repository-state change."
        },
        "aoh.solutionExplorer.dragAndDrop.confirm": {
          "type": "boolean",
          "default": true,
          "description": "Ask for confirmation before moving files or folders with drag & drop in the Solution Explorer."
        },
        "aoh.solutionExplorer.delete.confirm": {
          "type": "boolean",
          "default": true,
          "description": "Ask for confirmation before deleting files or folders from the Solution Explorer."
        },
        "aoh.solutionExplorer.delete.useTrash": {
          "type": "boolean",
          "default": true,
          "description": "Move deleted files and folders to the operating system trash/recycle bin when possible. Disable to delete directly."
        }
      }
    }
  },
