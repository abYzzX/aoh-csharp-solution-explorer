{
  "name": "aoh-solution-explorer",
  "displayName": "AOH - Solution Explorer",
  "description": "A Rider-inspired .NET solution explorer for VS Code.",
  "version": "0.0.0",
  "publisher": "AbYzzX",
  "icon": "media/aoh-csharp-solution-explorer.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/abYzzX/aoh-csharp-solution-explorer.git"
  },
  "bugs": {
    "url": "https://github.com/abYzzX/aoh-csharp-solution-explorer/issues"
  },
  "homepage": "https://github.com/abYzzX/aoh-csharp-solution-explorer#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "keybindings": [
      {
        "key": "ctrl+c",
        "mac": "cmd+c",
        "command": "aoh.solutionExplorer.copy",
        "when": "focusedView == 'aoh.solutionExplorer.view' && !inputFocus"
      },
      {
        "key": "ctrl+x",
        "mac": "cmd+x",
        "command": "aoh.solutionExplorer.cut",
        "when": "focusedView == 'aoh.solutionExplorer.view' && !inputFocus"
      },
      {
        "key": "ctrl+v",
        "mac": "cmd+v",
        "command": "aoh.solutionExplorer.paste",
        "when": "focusedView == 'aoh.solutionExplorer.view' && !inputFocus"
      },
      {
        "key": "delete",
        "mac": "cmd+backspace",
        "command": "aoh.solutionExplorer.delete",
        "when": "focusedView == 'aoh.solutionExplorer.view' && !inputFocus"
      },
      {
        "key": "f2",
        "command": "aoh.solutionExplorer.rename",
        "when": "focusedView == 'aoh.solutionExplorer.view' && !inputFocus"
      },
      {
        "key": "ctrl+shift+n",
        "mac": "cmd+shift+n",
        "command": "aoh.solutionExplorer.newFolder",
        "when": "focusedView == 'aoh.solutionExplorer.view' && !inputFocus"
      },
      {
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n",
        "command": "aoh.solutionExplorer.newFile",
        "when": "focusedView == 'aoh.solutionExplorer.view' && !inputFocus"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aoh-solution-explorer",
          "title": "AOH - Solution Explorer",
          "icon": "media/explorer.svg"
        }
      ]
    },
    "views": {
      "aoh-solution-explorer": [
        {
          "id": "aoh.solutionExplorer.view",
          "name": "Solution"
        }
      ]
    },
    "commands": [
      {
        "command": "aoh.solutionExplorer.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "aoh.solutionExplorer.createSolution",
        "title": "Create New Solution...",
        "icon": "$(new-file)"
      },
      {
        "command": "aoh.solutionExplorer.selectCurrentFile",
        "title": "Select Current File",
        "icon": {
          "light": "media/select-current-file.svg",
          "dark": "media/select-current-file.svg"
        }
      },
      {
        "command": "aoh.solutionExplorer.enableFollowEditor",
        "title": "Follow Editor File",
        "icon": {
          "light": "media/follow-active-file-disabled.svg",
          "dark": "media/follow-active-file-disabled.svg"
        }
      },
      {
        "command": "aoh.solutionExplorer.disableFollowEditor",
        "title": "Stop Following Editor File",
        "icon": {
          "light": "media/follow-active-file.svg",
          "dark": "media/follow-active-file.svg"
        }
      },
      {
        "command": "aoh.solutionExplorer.newProject",
        "title": "Add Project",
        "icon": "$(project)"
      },
      {
        "command": "aoh.solutionExplorer.newSolutionFolder",
        "title": "New Solution Folder",
        "icon": "$(new-folder)"
      },
      {
        "command": "aoh.solutionExplorer.addExistingProject",
        "title": "Add Existing Project...",
        "icon": "$(project)"
      },
      {
        "command": "aoh.solutionExplorer.addExistingItem",
        "title": "Add Existing Item...",
        "icon": "$(file-add)"
      },
      {
        "command": "aoh.solutionExplorer.newFile",
        "title": "New File...",
        "icon": "$(new-file)"
      },
      {
        "command": "aoh.solutionExplorer.newFolder",
        "title": "Create Folder",
        "icon": "$(new-folder)"
      },
      {
        "command": "aoh.solutionExplorer.newDotNetFile",
        "title": "Add...",
        "icon": "$(new-file)"
      },
      {
        "command": "aoh.solutionExplorer.addProjectReference",
        "title": "Project Reference...",
        "icon": "$(references)"
      },
      {
        "command": "aoh.solutionExplorer.gitStage",
        "title": "Stage",
        "icon": "$(check)"
      },
      {
        "command": "aoh.solutionExplorer.gitUnstage",
        "title": "Git: Unstage",
        "icon": "$(remove)"
      },
      {
        "command": "aoh.solutionExplorer.gitRollback",
        "title": "Rollback",
        "icon": "$(discard)"
      },
      {
        "command": "aoh.solutionExplorer.buildSolution",
        "title": "Build Solution"
      },
      {
        "command": "aoh.solutionExplorer.rebuildSolution",
        "title": "Rebuild Solution"
      },
      {
        "command": "aoh.solutionExplorer.cleanSolution",
        "title": "Clean Solution"
      },
      {
        "command": "aoh.solutionExplorer.buildProject",
        "title": "Build Project"
      },
      {
        "command": "aoh.solutionExplorer.rebuildProject",
        "title": "Rebuild Project"
      },
      {
        "command": "aoh.solutionExplorer.cleanProject",
        "title": "Clean Project"
      },
      {
        "command": "aoh.solutionExplorer.packProject",
        "title": "Pack Project"
      },
      {
        "command": "aoh.solutionExplorer.publishProject",
        "title": "Publish Project..."
      },
      {
        "command": "aoh.solutionExplorer.open",
        "title": "Open"
      },
      {
        "command": "aoh.solutionExplorer.openToSide",
        "title": "Open to the Side"
      },
      {
        "command": "aoh.solutionExplorer.rename",
        "title": "Rename...",
        "icon": "$(edit)"
      },
      {
        "command": "aoh.solutionExplorer.delete",
        "title": "Delete",
        "icon": "$(trash)"
      },
      {
        "command": "aoh.solutionExplorer.copyPath",
        "title": "Copy Path"
      },
      {
        "command": "aoh.solutionExplorer.copyRelativePath",
        "title": "Copy Relative Path"
      },
      {
        "command": "aoh.solutionExplorer.openTerminal",
        "title": "Open in Integrated Terminal",
        "icon": "$(terminal)"
      },
      {
        "command": "aoh.solutionExplorer.reveal",
        "title": "Open Containing Folder",
        "icon": "$(folder-opened)"
      },
      {
        "command": "aoh.solutionExplorer.findInFiles",
        "title": "Find in Files..."
      },
      {
        "command": "aoh.solutionExplorer.replaceInFiles",
        "title": "Replace in Files..."
      },
      {
        "command": "aoh.solutionExplorer.newClass",
        "title": "Class",
        "icon": "$(symbol-class)"
      },
      {
        "command": "aoh.solutionExplorer.newInterface",
        "title": "Interface",
        "icon": "$(symbol-interface)"
      },
      {
        "command": "aoh.solutionExplorer.newEnum",
        "title": "Enum",
        "icon": "$(symbol-enum)"
      },
      {
        "command": "aoh.solutionExplorer.newStruct",
        "title": "Struct",
        "icon": "$(symbol-struct)"
      },
      {
        "command": "aoh.solutionExplorer.newRecord",
        "title": "Record",
        "icon": "$(symbol-class)"
      },
      {
        "command": "aoh.solutionExplorer.copy",
        "title": "Copy",
        "icon": "$(copy)"
      },
      {
        "command": "aoh.solutionExplorer.cut",
        "title": "Cut",
        "icon": "$(clippy)"
      },
      {
        "command": "aoh.solutionExplorer.paste",
        "title": "Paste",
        "icon": "$(files)"
      },
      {
        "command": "aoh.solutionExplorer.duplicate",
        "title": "Duplicate...",
        "icon": "$(files)"
      },
      {
        "command": "aoh.solutionExplorer.copyPathSolution",
        "title": "Relative to Solution",
        "icon": "$(file-symlink-file)"
      },
      {
        "command": "aoh.solutionExplorer.copyPathWorkspace",
        "title": "Copy Relative Path",
        "icon": "$(file-symlink-file)"
      },
      {
        "command": "aoh.solutionExplorer.copyPathFull",
        "title": "Copy Path",
        "icon": "$(copy)"
      },
      {
        "command": "aoh.solutionExplorer.gitTrack",
        "title": "Track",
        "icon": "$(add)"
      },
      {
        "command": "aoh.solutionExplorer.gitUntrack",
        "title": "Untrack",
        "icon": "$(remove)"
      },
      {
        "command": "aoh.solutionExplorer.showExcludedFiles",
        "title": "Show Excluded Files",
        "icon": {
          "light": "media/show_files.svg",
          "dark": "media/show_files.svg"
        }
      },
      {
        "command": "aoh.solutionExplorer.hideExcludedFiles",
        "title": "Hide Excluded Files",
        "icon": {
          "light": "media/hide_files.svg",
          "dark": "media/hide_files.svg"
        }
      },
      {
        "command": "aoh.solutionExplorer.showOutput",
        "title": "Show AOH Solution Explorer Output",
        "icon": "$(output)"
      },
      {
        "command": "aoh.solutionExplorer.installNugetPackage",
        "title": "Install NuGet Package"
      },
      {
        "command": "aoh.solutionExplorer.manageProjectReferences",
        "title": "Manage Project References"
      },
      {
        "command": "aoh.solutionExplorer.removeProject",
        "title": "Remove",
        "icon": "$(trash)"
      },
      {
        "command": "aoh.solutionExplorer.adjustNamespaces",
        "title": "Adjust Namespaces"
      },
      {
        "command": "aoh.solutionExplorer.editSolutionFile",
        "title": "Edit Solution File",
        "icon": "$(edit)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "aoh.solutionExplorer.selectCurrentFile",
          "when": "view == aoh.solutionExplorer.view",
          "group": "navigation@1"
        },
        {
          "command": "aoh.solutionExplorer.enableFollowEditor",
          "when": "view == aoh.solutionExplorer.view && !aoh.solutionExplorer.followEditor",
          "group": "navigation@2"
        },
        {
          "command": "aoh.solutionExplorer.disableFollowEditor",
          "when": "view == aoh.solutionExplorer.view && aoh.solutionExplorer.followEditor",
          "group": "navigation@2"
        },
        {
          "command": "aoh.solutionExplorer.showExcludedFiles",
          "when": "view == aoh.solutionExplorer.view && !aoh.solutionExplorer.showExcludedFiles",
          "group": "navigation@3"
        },
        {
          "command": "aoh.solutionExplorer.hideExcludedFiles",
          "when": "view == aoh.solutionExplorer.view && aoh.solutionExplorer.showExcludedFiles",
          "group": "navigation@3"
        },
        {
          "command": "aoh.solutionExplorer.refresh",
          "when": "view == aoh.solutionExplorer.view",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "aoh.solutionExplorer.installNugetPackage",
          "when": "view == aoh.solutionExplorer.view && viewItem == aoh.dependencies",
          "group": "1_dependencies@1"
        },
        {
          "command": "aoh.solutionExplorer.manageProjectReferences",
          "when": "view == aoh.solutionExplorer.view && viewItem == aoh.dependencies",
          "group": "1_dependencies@2"
        },
        {
          "command": "aoh.solutionExplorer.cut",
          "when": "view == aoh.solutionExplorer.view && viewItem =~ /aoh\\.(folder|file)/",
          "group": "3_clipboard@1"
        },
        {
          "command": "aoh.solutionExplorer.copy",
          "when": "view == aoh.solutionExplorer.view && viewItem =~ /aoh\\.(folder|file)/",
          "group": "3_clipboard@2"
        },
        {
          "command": "aoh.solutionExplorer.delete",
          "when": "view == aoh.solutionExplorer.view && viewItem =~ /aoh\\.(solutionFolder|folder|file)/",
          "group": "5_modify@1"
        },
        {
          "command": "aoh.solutionExplorer.rename",
          "when": "view == aoh.solutionExplorer.view && viewItem =~ /aoh\\.(folder|file)/",
          "group": "6_rename@1"
        },
        {
          "command": "aoh.solutionExplorer.buildSolution",
          "when": "view == aoh.solutionExplorer.view && viewItem == aoh.solution",
          "group": "5_build@1"
        },
        {
          "command": "aoh.solutionExplorer.rebuildSolution",
          "when": "view == aoh.solutionExplorer.view && viewItem == aoh.solution",
          "group": "5_build@2"
        },
        {
          "command": "aoh.solutionExplorer.cleanSolution",
          "when": "view == aoh.solutionExplorer.view && viewItem == aoh.solution",
          "group": "5_build@3"
        },
        {
          "submenu": "aoh.solutionExplorer.add",
          "when": "view == aoh.solutionExplorer.view && viewItem =~ /^aoh\\.(solution|solutionFolder|project|folder|file)$/",
          "group": "1_add@1"
        },
        {
          "command": "aoh.solutionExplorer.newFolder",
          "when": "view == aoh.solutionExplorer.view && viewItem == aoh.project",
          "group": "2_create@1"
        },
        {
          "command": "aoh.solutionExplorer.reveal",
          "when": "view == aoh.solutionExplorer.view && viewItem == aoh.project",
          "group": "3_open@1"
        },
        {
          "command": "aoh.solutionExplorer.openTerminal",
          "when": "view == aoh.solutionExplorer.view && viewItem == aoh.project",
          "group": "3_open@2"
        },
        {
          "command": "aoh.solutionExplorer.removeProject",
          "when": "view == aoh.solutionExplorer.view && viewItem == aoh.project",
          "group": "4_remove@1"
        },
        {
          "command": "aoh.solutionExplorer.installNugetPackage",
          "when": "view == aoh.solutionExplorer.view && viewItem == aoh.project",
          "group": "5_dependencies@1"
        },
        {
          "command": "aoh.solutionExplorer.manageProjectReferences",
          "when": "view == aoh.solutionExplorer.view && viewItem == aoh.project",
          "group": "5_dependencies@2"
        },
        {
          "command": "aoh.solutionExplorer.paste",
          "when": "view == aoh.solutionExplorer.view && viewItem == aoh.project",
          "group": "6_paste@1"
        },
        {
          "command": "aoh.solutionExplorer.copyPathFull",
          "when": "view == aoh.solutionExplorer.view && viewItem == aoh.project",
          "group": "7_path@1"
        },
        {
          "command": "aoh.solutionExplorer.copyPathWorkspace",
          "when": "view == aoh.solutionExplorer.view && viewItem == aoh.project",
          "group": "7_path@2"
        },
        {
          "command": "aoh.solutionExplorer.buildProject",
          "when": "view == aoh.solutionExplorer.view && viewItem == aoh.project",
          "group": "8_build@1"
        },
        {
          "command": "aoh.solutionExplorer.rebuildProject",
          "when": "view == aoh.solutionExplorer.view && viewItem == aoh.project",
          "group": "8_build@2"
        },
        {
          "command": "aoh.solutionExplorer.cleanProject",
          "when": "view == aoh.solutionExplorer.view && viewItem == aoh.project",
          "group": "8_build@3"
        },
        {
          "command": "aoh.solutionExplorer.reveal",
          "when": "view == aoh.solutionExplorer.view && viewItem == aoh.file",
          "group": "2_open@1"
        },
        {
          "command": "aoh.solutionExplorer.openTerminal",
          "when": "view == aoh.solutionExplorer.view && viewItem == aoh.file",
          "group": "2_open@2"
        },
        {
          "command": "aoh.solutionExplorer.paste",
          "when": "view == aoh.solutionExplorer.view && viewItem == aoh.file",
          "group": "3_clipboard@3"
        },
        {
          "command": "aoh.solutionExplorer.copyPathFull",
          "when": "view == aoh.solutionExplorer.view && viewItem == aoh.file",
          "group": "6_path@1"
        },
        {
          "command": "aoh.solutionExplorer.copyPathWorkspace",
          "when": "view == aoh.solutionExplorer.view && viewItem == aoh.file",
          "group": "6_path@2"
        },
        {
          "command": "aoh.solutionExplorer.reveal",
          "when": "view == aoh.solutionExplorer.view && viewItem == aoh.folder",
          "group": "2_open@1"
        },
        {
          "command": "aoh.solutionExplorer.openTerminal",
          "when": "view == aoh.solutionExplorer.view && viewItem == aoh.folder",
          "group": "2_open@2"
        },
        {
          "command": "aoh.solutionExplorer.paste",
