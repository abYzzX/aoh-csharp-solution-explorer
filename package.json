          "group": "1_add@3"
        },
        {
          "command": "aoh.solutionExplorer.newDotNetFile",
          "when": "viewItem =~ /aoh\\.(project|folder|file)/",
          "group": "1_add@1"
        },
        {
          "command": "aoh.solutionExplorer.newClass",
          "when": "viewItem =~ /aoh\\.(project|folder|file)/",
          "group": "2_types@1"
        },
        {
          "command": "aoh.solutionExplorer.newInterface",
          "when": "viewItem =~ /aoh\\.(project|folder|file)/",
          "group": "2_types@2"
        },
        {
          "command": "aoh.solutionExplorer.newEnum",
